{
    "name": "sohophp/sofinder-s3",
    "description": "S3-compatible object storage adapter for SoFinder",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/sohophp/sofinder-s3",
    "keywords": ["sofinder", "s3", "object-storage", "cloudflare-r2", "minio"],
    "support": {
        "issues": "https://github.com/sohophp/sofinder-s3/issues",
        "source": "https://github.com/sohophp/sofinder-s3"
    },
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.356",
        "sohophp/sofinder-core": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/dotenv": "^6.4 || ^7.4"
    },
    "conflict": {
        "sohophp/sofinder-legacy": "*"
    },
    "autoload": {
        "psr-4": {
            "SohoPHP\\SoFinderS3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SohoPHP\\SoFinderS3\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "sohophp/sofinder-symfony": "Enables automatic Symfony service registration for the S3 adapter"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
